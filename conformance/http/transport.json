      {
        "clear": true,
        "method": "GET",
        "path": "/note",
        "select": [
          "errors.0.status"
        ]
      },
      {
        "clear": true,
        "method": "POST",
        "path": "/note",
        "body": {
          "data": {
            "type": "note",
            "attributes": {
              "title": "x"
            }
          }
        },
        "select": [
          "errors.0.status"
        ]
      },
      {
        "as": null,
        "method": "GET",
        "path": "/note",
        "select": [
          "errors.0.status"
        ]
      }
    ]
  },
  "output": [
    {
      "status": 200
    },
    {
      "status": 426,
