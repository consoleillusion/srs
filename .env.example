# Copy to .env. Never commit the real file.

# --- Storage ---
DB_PATH=.db
# MIGRATE_ON_START=false        # apply migrations yourself instead of at startup

# --- Server ---
PORT=5734
# SRS_RETAIN_READS=false        # true keeps every signed read's signature in the audit log
# SRS_TRANSPORT=noise           # noise (default, secure without TLS) or bearer (needs TLS)
# SRS_MAX_BODY_BYTES=1048576    # largest accepted request body
# SRS_RATE_LIMIT_PER_MINUTE=600 # per client address; 0 turns the limit off
# SRS_TRUSTED_PROXY_HOPS=0      # reverse proxies in front of the server (set to 1 behind one proxy)
# SRS_CORS_ORIGINS=https://app.example.com   # comma-separated; none by default; * allows any
# SRS_LOG=true                  # one JSON line per request; false turns it off
# SRS_METRICS_PORT=9734         # serve /metrics on 127.0.0.1 only; unset turns it off

# --- Server key bundle for the Noise transport. `srs init` prints a value and its fingerprint. ---
SRS_SERVER_KEYS=

# --- Built-in accounts (OPAQUE). `srs init` prints a value to use here. ---
OPAQUE_SERVER_SETUP=
# SRS_ADMINS=alice,bob          # usernames that always hold the admin role

# --- External identity provider (OpenID Connect). Use instead of, or with, OPAQUE. ---
# SRS_OIDC_ISSUER=https://idp.example.com/realms/main
# SRS_OIDC_AUDIENCE=srs-api
# SRS_OIDC_JWKS_URI=            # only when the provider does not publish discovery
# SRS_OIDC_ADMIN_SUBJECTS=      # comma-separated `sub` values that hold the admin role

# --- Backups taken while the server runs ---
# SRS_BACKUP_DIR=/backups
# SRS_BACKUP_INTERVAL_HOURS=24
# SRS_BACKUP_KEEP=7
